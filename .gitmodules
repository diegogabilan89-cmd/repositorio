# Los submódulos apuntan a los repositorios oficiales de EPrints en GitHub.
# (El original usaba rutas relativas "../x.git", que solo funcionan dentro
# de la organización github.com/eprints y fallan en cualquier fork.)
[submodule "ingredients/easy_pages"]
	path = ingredients/easy_pages
	url = https://github.com/eprints/easy_pages.git
[submodule "ingredients/richtext"]
	path = ingredients/richtext
	url = https://github.com/eprints/richtext.git
[submodule "flavours/pub_lib"]
	path = flavours/pub_lib
	url = https://github.com/eprints/pub_lib.git
[submodule "ingredients/latest_additions"]
	path = ingredients/latest_additions
	url = https://github.com/eprints/latest_additions.git
[submodule "ci/pytest/random_eprints"]
	path = ci/pytest/random_eprints
	url = https://github.com/eprints/random_eprints.git
