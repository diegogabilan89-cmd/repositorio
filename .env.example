# =============================================================================
#  Variables de entorno del Repositorio Digital HGI
#
#  1) Copia este archivo:    cp .env.example .env
#  2) Cambia TODAS las contraseñas antes del primer arranque.
#  3) El archivo .env NO se sube a GitHub (está en .gitignore).
#
#  Importante: las cuentas y la base de datos se crean en el PRIMER arranque.
#  Si después cambias contraseñas aquí, no se actualizan solas (ver docs).
# =============================================================================

# --- Identidad del repositorio ------------------------------------------------
# Identificador interno: minúsculas, números y "_" (no cambiar tras crearlo)
ARCHIVE_ID=hgi
EPRINTS_ARCHIVE_NAME=Repositorio Digital de Producción Científica e Investigación
EPRINTS_ORG_NAME=Hospital General de Itapúa

# --- Acceso web ---------------------------------------------------------------
# Nombre con el que se entra al repositorio. EPrints NO acepta "localhost"
# ni una IP. Opciones:
#   - En tu PC:  repositorio.localhost   (Chrome/Edge/Firefox lo resuelven a
#                                         127.0.0.1 automáticamente)
#   - En un VPS: tu dominio, o la IP con nip.io, p. ej. 203.0.113.10.nip.io
EPRINTS_HOSTNAME=repositorio.localhost
# Puerto (en un VPS normalmente 80)
EPRINTS_PORT=8080

# --- Base de datos (MariaDB) --------------------------------------------------
MARIADB_ROOT_PASSWORD=Cambiar_Root_2026
EPRINTS_DB_USER=hgi
# Solo letras, números y "_", empezando por letra (restricción de EPrints)
EPRINTS_DB_PASSWORD=Cambiar_BD_2026

# --- Cuentas de usuario (mínimo 8 caracteres, sin espacios ni comillas) -------
# Administrador: se crea automáticamente al crear el repositorio
EPRINTS_ADMIN_USER=admin
EPRINTS_ADMIN_PASSWORD=Cambiar_Admin_2026
EPRINTS_ADMIN_EMAIL=admin@hgi.localhost

# Editor/revisor y depositante: se crean con  docker compose exec eprints eprints-seed
EPRINTS_EDITOR_USER=editor
EPRINTS_EDITOR_PASSWORD=Cambiar_Editor_2026
EPRINTS_DEPOSITOR_USER=investigador
EPRINTS_DEPOSITOR_PASSWORD=Cambiar_Invest_2026

# --- Correo -------------------------------------------------------------------
# Por defecto los correos (registro, recuperar contraseña...) los captura
# Mailpit y se ven en http://localhost:8025 — no salen a Internet.
EPRINTS_SMTP_SERVER=mailpit:1025
MAILPIT_PORT=8025

# --- Rendimiento --------------------------------------------------------------
# Máximo de procesos Apache (cada uno usa ~60-100 MB de RAM)
APACHE_MAX_REQUEST_WORKERS=20
